# Include directories
EE_INCS := $(EE_INCS) -I$(PS2SDK)/ee/include -I$(PS2SDK)/ports/include -I$(PS2SDK)/common/include -I.

# Libs
EE_LDFLAGS := $(EE_LDFLAGS) -L$(PS2SDK)/ports/lib 

# C compiler flags
EE_CFLAGS := -D_EE -Os -G0 -Wall -Werror -Wno-unused-variable -Wno-unused-function -ffunction-sections -fdata-sections -fsingle-precision-constant $(EE_CFLAGS)

# C++ compiler flags
EE_CXXFLAGS := -D_EE -Os -G0 -Wall -Werror -Wno-unused-variable -Wno-unused-function -ffunction-sections -fdata-sections -fsingle-precision-constant $(EE_CXXFLAGS)

# Assembler flags
EE_ASFLAGS := -G0 $(EE_ASFLAGS)

# Externally defined variables: EE_BIN, EE_OBJS, EE_LIB

# These macros can be used to simplify certain build rules.
EE_C_COMPILE = $(EE_CC) $(EE_CFLAGS) $(EE_INCS)
EE_CXX_COMPILE = $(EE_CXX) $(EE_CXXFLAGS) $(EE_INCS)

common.o : /src/common/common.c
	$(EE_CC) $(EE_CFLAGS) $(EE_DEFS) $(EE_INCS) $(EE_LDFLAGS) -c $< -o $@

%.o : %.c
	$(EE_CC) $(EE_CFLAGS) $(EE_DEFS) $(EE_INCS) $(EE_LDFLAGS) -c $< -o $@

%.o : %.cc
	$(EE_CXX) $(EE_CXXFLAGS) $(EE_DEFS) $(EE_INCS) -c $< -o $@

%.o : %.cpp
	$(EE_CXX) $(EE_CXXFLAGS) $(EE_DEFS) $(EE_INCS) -c $< -o $@

%.o : %.S
	$(EE_CC) $(EE_CFLAGS) $(EE_DEFS) $(EE_INCS) -c $< -o $@

%.o : %.s
	$(EE_AS) $(EE_ASFLAGS) $< -o $@

ifeq ($(EE_SEPARATE_CODE),1)
# Check every allocated ELF section, including BSS and linker-generated sections.
define CHECK_MAP_CODE_SIZE
	@set -eu; \
	code_bytes=$$(wc -c < "$(EE_BIN)"); \
	if test "$$code_bytes" -gt 520192; then \
		printf 'ERROR: %s is %d bytes; map code must fit within 520192 bytes (0x01B80000..0x01BFF000)\n' "$(EE_BIN)" "$$code_bytes"; \
		exit 1; \
	fi; \
	code_sections=$$($(EE_PREFIX)objdump -h "$(EE_ELF)" | awk '/^[[:space:]]*[0-9]+[[:space:]]/ { address=$$4; size=$$3 } /ALLOC/ && size != "00000000" { print address ":" size }'); \
	test -n "$$code_sections" || { echo "ERROR: Missing allocated sections in $(EE_ELF)"; exit 1; }; \
	code_end=$$((0x01B80000)); \
	for section in $$code_sections; do \
		section_start=$$((0x$${section%:*})); \
		section_end=$$((section_start + 0x$${section#*:})); \
		if test "$$section_start" -lt $$((0x01B80000)) || test "$$section_end" -gt $$((0x01BFF000)); then \
			printf 'ERROR: %s runtime section 0x%08X..0x%08X exceeds 0x01B80000..0x01BFF000 (including BSS)\n' "$(EE_ELF)" "$$section_start" "$$section_end"; \
			exit 1; \
		fi; \
		if test "$$section_end" -gt "$$code_end"; then code_end=$$section_end; fi; \
	done; \
	printf '%s: %d binary bytes, runtime end 0x%08X (%d bytes free)\n' "$(EE_BIN)" "$$code_bytes" "$$code_end" $$((0x01BFF000 - code_end))
endef

.DELETE_ON_ERROR:
.PHONY: check-size
check-size: $(EE_BIN)
	$(CHECK_MAP_CODE_SIZE)
endif

$(EE_BIN) : $(EE_OBJS) crt0.o linkfile
	# $(EE_CC) -Os  -mno-crt0 -Tlinkfile $(EE_LDFLAGS) -s \
	#	-o $(EE_BIN) crt0.o $(EE_OBJS) $(EE_LIBS) -Wl,--gc-sections -Wl,--oformat=binary
	$(EE_CC) -g -mno-crt0 -Tlinkfile $(EE_LDFLAGS) \
		-o $(EE_ELF) crt0.o $(EE_OBJS) $(EE_LIBS) -Wl,--gc-sections
	$(EE_OBJCOPY) -O binary $(EE_ELF) $(EE_BIN)
	$(CHECK_MAP_CODE_SIZE)
